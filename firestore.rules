rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isVerified() && request.auth.token.email == 'abhinavsingha369@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() || (
        isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidAgentId(agentId) {
      return agentId in ['sales', 'marketing', 'research', 'finance', 'support', 'operations'];
    }

    // Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'plan', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'photoURL', 'role', 'plan', 'status', 'company', 'jobTitle', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.role in ['user', 'admin']
        && data.plan in ['free', 'pro', 'business', 'enterprise']
        && data.status in ['active', 'suspended']
        && (!('company' in data) || (data.company is string && data.company.size() <= 120))
        && (!('jobTitle' in data) || (data.jobTitle is string && data.jobTitle.size() <= 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidAgentConfig(data) {
      return data.keys().hasAll(['agentId', 'name', 'role', 'description', 'systemInstructions', 'status', 'model', 'updatedAt'])
        && data.keys().hasOnly(['agentId', 'name', 'role', 'description', 'systemInstructions', 'status', 'model', 'updatedAt'])
        && isValidAgentId(data.agentId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.role is string && data.role.size() >= 1 && data.role.size() <= 120
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 500
        && data.systemInstructions is string && data.systemInstructions.size() >= 1 && data.systemInstructions.size() <= 4000
        && data.status in ['active', 'maintenance', 'disabled']
        && data.model in ['gemini-4-hydrogen', 'gemini-3.1-flash-lite']
        && data.updatedAt is timestamp;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['conversationId', 'userId', 'agentId', 'title', 'archived', 'messageCount', 'lastMessagePreview', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['conversationId', 'userId', 'agentId', 'title', 'archived', 'messageCount', 'lastMessagePreview', 'createdAt', 'updatedAt'])
        && isValidId(data.conversationId)
        && isValidId(data.userId)
        && isValidAgentId(data.agentId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.archived is bool
        && data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 10000
        && data.lastMessagePreview is string && data.lastMessagePreview.size() <= 240
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['messageId', 'conversationId', 'userId', 'role', 'content', 'inputTokens', 'outputTokens', 'model', 'createdAt'])
        && data.keys().hasOnly(['messageId', 'conversationId', 'userId', 'role', 'content', 'inputTokens', 'outputTokens', 'model', 'createdAt'])
        && isValidId(data.messageId)
        && isValidId(data.conversationId)
        && isValidId(data.userId)
        && data.role in ['user', 'assistant']
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 32000
        && data.inputTokens is int && data.inputTokens >= 0 && data.inputTokens <= 1000000
        && data.outputTokens is int && data.outputTokens >= 0 && data.outputTokens <= 1000000
        && data.model is string && data.model.size() >= 1 && data.model.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidSavedOutput(data) {
      return data.keys().hasAll(['outputId', 'userId', 'agentId', 'title', 'content', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['outputId', 'userId', 'agentId', 'title', 'content', 'conversationId', 'createdAt', 'updatedAt'])
        && isValidId(data.outputId)
        && isValidId(data.userId)
        && isValidAgentId(data.agentId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 32000
        && (!('conversationId' in data) || (data.conversationId is string && data.conversationId.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUsageRecord(data) {
      return data.keys().hasAll(['usageId', 'userId', 'agentId', 'date', 'month', 'requestCount', 'inputTokens', 'outputTokens', 'updatedAt'])
        && data.keys().hasOnly(['usageId', 'userId', 'agentId', 'date', 'month', 'requestCount', 'inputTokens', 'outputTokens', 'updatedAt'])
        && isValidId(data.usageId)
        && isValidId(data.userId)
        && isValidAgentId(data.agentId)
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.month is string && data.month.size() == 7 && data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && data.requestCount is int && data.requestCount >= 1 && data.requestCount <= 100000
        && data.inputTokens is int && data.inputTokens >= 0 && data.inputTokens <= 100000000
        && data.outputTokens is int && data.outputTokens >= 0 && data.outputTokens <= 100000000
        && data.updatedAt is timestamp;
    }

    function isValidPromptTemplate(data) {
      return data.keys().hasAll(['templateId', 'userId', 'isPublic', 'category', 'title', 'description', 'promptContent', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['templateId', 'userId', 'isPublic', 'category', 'title', 'description', 'promptContent', 'createdAt', 'updatedAt'])
        && isValidId(data.templateId)
        && isValidId(data.userId)
        && data.isPublic is bool
        && isValidAgentId(data.category)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 300
        && data.promptContent is string && data.promptContent.size() >= 1 && data.promptContent.size() <= 4000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFavoritePrompt(data) {
      return data.keys().hasAll(['favoriteId', 'userId', 'templateId', 'createdAt'])
        && data.keys().hasOnly(['favoriteId', 'userId', 'templateId', 'createdAt'])
        && isValidId(data.favoriteId)
        && isValidId(data.userId)
        && isValidId(data.templateId)
        && data.createdAt is timestamp;
    }

    function isValidFeedbackItem(data) {
      return data.keys().hasAll(['feedbackId', 'userId', 'userEmail', 'feedbackType', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['feedbackId', 'userId', 'userEmail', 'feedbackType', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.feedbackId)
        && isValidId(data.userId)
        && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 254
        && data.feedbackType in ['bug', 'feature', 'agent_quality', 'general']
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 160
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 3000
        && data.status in ['open', 'in_review', 'resolved']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || (
          isOwner(userId)
          && incoming().role == 'user'
          && incoming().plan == 'free'
          && incoming().status == 'active'
        ));
      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || (
          isOwner(userId)
          && incoming().role == existing().role
          && incoming().plan == existing().plan
          && incoming().status == existing().status
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoURL', 'company', 'jobTitle', 'updatedAt'])
        ));
      allow delete: if isVerified() && isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isBootstrapAdmin()
        && isValidId(userId)
        && isValidAdminRecord(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isBootstrapAdmin() && isValidId(userId);
    }

    match /agents/{agentId} {
      allow get: if isSignedIn() && isValidAgentId(agentId);
      allow list: if isSignedIn() && resource.data.status in ['active', 'maintenance', 'disabled'];
      allow create: if isAdmin()
        && isValidAgentId(agentId)
        && isValidAgentConfig(incoming())
        && incoming().agentId == agentId
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidAgentId(agentId)
        && isValidAgentConfig(incoming())
        && incoming().agentId == existing().agentId
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified()
        && isValidId(conversationId)
        && isValidConversation(incoming())
        && incoming().conversationId == conversationId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(conversationId)
        && isValidConversation(incoming())
        && incoming().conversationId == existing().conversationId
        && incoming().userId == existing().userId
        && incoming().agentId == existing().agentId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || (
          existing().userId == request.auth.uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'archived', 'messageCount', 'lastMessagePreview', 'updatedAt'])
        ));
      allow delete: if isVerified() && isValidId(conversationId) && (existing().userId == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow get: if isSignedIn()
          && isValidId(conversationId)
          && isValidId(messageId)
          && (isAdmin() || (
            existing().userId == request.auth.uid
            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid
          ));
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if isVerified()
          && isValidId(conversationId)
          && isValidId(messageId)
          && isValidMessage(incoming())
          && incoming().messageId == messageId
          && incoming().conversationId == conversationId
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/conversations/$(conversationId))
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if isVerified()
          && isValidId(conversationId)
          && isValidId(messageId)
          && (isAdmin() || (
            existing().userId == request.auth.uid
            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid
          ));
      }
    }

    match /savedOutputs/{outputId} {
      allow get: if isSignedIn() && isValidId(outputId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified()
        && isValidId(outputId)
        && isValidSavedOutput(incoming())
        && incoming().outputId == outputId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(outputId)
        && isValidSavedOutput(incoming())
        && incoming().outputId == existing().outputId
        && incoming().userId == existing().userId
        && incoming().agentId == existing().agentId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || (
          existing().userId == request.auth.uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'updatedAt'])
        ));
      allow delete: if isVerified() && isValidId(outputId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /usage/{usageId} {
      allow get: if isSignedIn() && isValidId(usageId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified()
        && isValidId(usageId)
        && isValidUsageRecord(incoming())
        && incoming().usageId == usageId
        && incoming().userId == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(usageId)
        && isValidUsageRecord(incoming())
        && incoming().usageId == existing().usageId
        && incoming().userId == existing().userId
        && incoming().agentId == existing().agentId
        && incoming().date == existing().date
        && incoming().month == existing().month
        && incoming().updatedAt == request.time
        && (isAdmin() || (
          existing().userId == request.auth.uid
          && incoming().requestCount >= existing().requestCount
          && incoming().diff(existing()).affectedKeys().hasOnly(['requestCount', 'inputTokens', 'outputTokens', 'updatedAt'])
        ));
      allow delete: if isVerified() && isValidId(usageId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /promptTemplates/{templateId} {
      allow get: if isSignedIn() && isValidId(templateId) && (existing().isPublic == true || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.isPublic == true || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified()
        && isValidId(templateId)
        && isValidPromptTemplate(incoming())
        && incoming().templateId == templateId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || (incoming().userId == request.auth.uid && incoming().isPublic == false));
      allow update: if isVerified()
        && isValidId(templateId)
        && isValidPromptTemplate(incoming())
        && incoming().templateId == existing().templateId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || (
          existing().userId == request.auth.uid
          && incoming().isPublic == false
          && incoming().diff(existing()).affectedKeys().hasOnly(['category', 'title', 'description', 'promptContent', 'updatedAt'])
        ));
      allow delete: if isVerified() && isValidId(templateId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /favoritePrompts/{favoriteId} {
      allow get: if isSignedIn() && isValidId(favoriteId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified()
        && isValidId(favoriteId)
        && isValidFavoritePrompt(incoming())
        && incoming().favoriteId == favoriteId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerified() && isValidId(favoriteId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /feedback/{feedbackId} {
      allow get: if isSignedIn() && isValidId(feedbackId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified()
        && isValidId(feedbackId)
        && isValidFeedbackItem(incoming())
        && incoming().feedbackId == feedbackId
        && incoming().userId == request.auth.uid
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(feedbackId)
        && isValidFeedbackItem(incoming())
        && incoming().feedbackId == existing().feedbackId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isVerified() && isValidId(feedbackId) && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
